<script type="text/javascript">
  if (window.newrelic) {
    const attributeName = 'enduserId';
    try {
      const cookieValue = document.cookie
        .split("; ")
        .find((row) => row.startsWith(`${window.cfSessionCookieName}=`))
        ?.split("=")[1];
      if (cookieValue) {
        const decoded = decodeURIComponent(cookieValue);
        const sessionCookie = JSON.parse(decoded);
        newrelic.setCustomAttribute(attributeName, sessionCookie.name);
      }
    } catch(e) {
      newrelic.noticeError(e)
    }
  }
</script>


